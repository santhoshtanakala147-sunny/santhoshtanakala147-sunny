<svg width="850" height="300" viewBox="0 0 850 300"
     xmlns="http://www.w3.org/2000/svg">

  <defs>

    <!-- Golden glow -->
    <filter id="glow">
      <feGaussianBlur stdDeviation="5" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>

    <!-- Moving light -->
    <linearGradient id="shine">
      <stop offset="0%" stop-color="#F59E0B" stop-opacity="0.15"/>
      <stop offset="45%" stop-color="#FFF7C2"/>
      <stop offset="50%" stop-color="#FFFFFF"/>
      <stop offset="55%" stop-color="#FFF7C2"/>
      <stop offset="100%" stop-color="#F59E0B" stop-opacity="0.15"/>

      <animateTransform
        attributeName="gradientTransform"
        type="translate"
        from="-1 0"
        to="2 0"
        dur="2.5s"
        repeatCount="indefinite"/>
    </linearGradient>

    <!-- Snake-like curve -->
    <path id="snakePath"
      d="M 120 155
         C 190 70, 270 70, 340 145
         S 490 225, 560 145
         S 700 65, 760 145"
      fill="none"/>

  </defs>

  <!-- Dark background -->
  <rect width="850" height="300"
        rx="25"
        fill="#0D1117"/>

  <!-- Snake trail -->
  <path
    d="M 100 160
       C 180 55, 270 65, 345 145
       S 490 230, 570 145
       S 700 60, 770 145"
    fill="none"
    stroke="#F59E0B"
    stroke-width="2"
    opacity="0.35"
    filter="url(#glow)"/>

  <!-- Moving light along snake -->
  <path
    d="M 100 160
       C 180 55, 270 65, 345 145
       S 490 230, 570 145
       S 700 60, 770 145"
    fill="none"
    stroke="#FFD166"
    stroke-width="4"
    stroke-linecap="round"
    stroke-dasharray="8 18"
    filter="url(#glow)">

    <animate
      attributeName="stroke-dashoffset"
      from="0"
      to="-130"
      dur="2s"
      repeatCount="indefinite"/>
  </path>

  <!-- Your name -->
  <text
    font-family="Georgia, 'Times New Roman', serif"
    font-size="76"
    font-weight="bold"
    letter-spacing="4"
    fill="url(#shine)"
    stroke="#F59E0B"
    stroke-width="0.8"
    filter="url(#glow)">

    <textPath
      href="#snakePath"
      startOffset="50%"
      text-anchor="middle">

      Santhosh

    </textPath>

  </text>

  <!-- Sparkles -->
  <g fill="#FFF7C2" filter="url(#glow)">

    <text x="105" y="105" font-size="22">
      ✦
      <animate
        attributeName="opacity"
        values="0.2;1;0.2"
        dur="1.4s"
        repeatCount="indefinite"/>
    </text>

    <text x="740" y="95" font-size="18">
      ✦
      <animate
        attributeName="opacity"
        values="1;0.15;1"
        dur="1.8s"
        repeatCount="indefinite"/>
    </text>

    <text x="425" y="245" font-size="20">
      ✧
      <animate
        attributeName="opacity"
        values="0.1;1;0.1"
        dur="1.2s"
        repeatCount="indefinite"/>
    </text>

  </g>

</svg>
